# Copy this file to .env.local and fill in your real values.

# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Drive (Files/Discussions/Votes file upload) — Google Cloud Console → APIs & Services → Credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Email notifications (discussions/votes) — SendGrid
# 1) sendgrid.com এ ফ্রি অ্যাকাউন্ট বানান
# 2) Settings → Sender Authentication → Single Sender Verification দিয়ে একটা ইমেইল ভেরিফাই করুন
# 3) Settings → API Keys দিয়ে একটা key বানান
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# WhatsApp notifications (discussions/votes) — Twilio WhatsApp Sandbox
# console.twilio.com → Messaging → Try it out → Send a WhatsApp message
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# নোটিফিকেশন ইমেইলের ভেতরের লিংক এই ডোমেইন দিয়ে বানানো হয় (না দিলে Vercel-এর
# ডিফল্ট deployment URL ব্যবহার হয়)
NEXT_PUBLIC_APP_URL=
